apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: __SERVICE__
  labels:
    app: __SERVICE__
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-parameter-store
    kind: ClusterSecretStore
  target:
    name: __SERVICE__-secret
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: Opaque
  data:
    # Repeat this entry once per secret key.
    - secretKey: __SECRET_KEY__
      remoteRef:
        key: __SSM_PREFIX__/__SERVICE__/__SSM_PARAM__
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
