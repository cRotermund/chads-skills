FROM --platform=$BUILDPLATFORM golang:__GO_VERSION__-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

# The build context is the repository root so sibling workspace modules can be
# copied in when this service depends on them (see the skill's multi-module notes).
WORKDIR /src/services/__SERVICE__
COPY src/services/__SERVICE__/go.mod src/services/__SERVICE__/go.sum ./
RUN go mod download
COPY src/services/__SERVICE__/ ./
RUN CGO_ENABLED=0 GOWORK=off GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /server .

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /server /server

EXPOSE __PORT__
USER 65532:65532

ENTRYPOINT ["/server"]
